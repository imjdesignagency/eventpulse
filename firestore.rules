rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile access
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.role == 'organizer');
    }

    // Events and bookings access
    match /events/{eventId} {
      allow read, write: if request.auth != null;
    }

    // Guest lists and tickets
    match /guests/{guestId} {
      allow read, write: if request.auth != null;
    }

    // WhatsApp logs and configs
    match /whatsapp_logs/{logId} {
      allow read, write: if request.auth != null;
    }

    match /bookings/{bookingId} {
      allow read, write: if request.auth != null;
    }

    // Fallback for authenticated app actions
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
